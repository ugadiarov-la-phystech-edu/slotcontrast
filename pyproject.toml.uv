[project]
name = "SlotContrast"
version = "0.1.0"
description = "Temporally Consistent Object-Centric Learning by Contrasting Slots"
authors = [
    { name = "Anna Manasyan" },
    { name = "Andrii Zadaianchuk" },
]
requires-python = ">=3.10,<3.11"
readme = "README.md"
dependencies = [
    "numpy>=1.23.3,<2",
    "torch>=1.13.0,<2",
    "torchvision>=0.14.0,<0.15",
    "torchmetrics>=1.2.0,<2",
    "pytorch-lightning>=1.8.3,<2",
    "timm>=0.9.7,<0.10",
    "omegaconf>=2.2.3,<3",
    "webdataset>=0.2.35,<0.3",
    "einops>=0.6.0,<0.7",
    "scipy>=1.10.1,<2",
    "tensorflow-datasets==4.9.7",
    "moviepy>=1.0.3,<2",
    "requests>=2.31.0,<3",
    "av>=12.0.0,<13",
]

[project.optional-dependencies]
tensorflow = ["tensorflow-cpu==2.18.0"]
coco = ["pycocotools>=2.0.6,<3"]
notebook = [
    "notebook>=6.5.2,<7",
    "matplotlib>=3.6.2,<4",
]

[dependency-groups]
dev = [
    "black>=22.10.0,<23",
    "isort>=5.12.0,<6",
    "pytest>=7.1.3,<8",
    "pre-commit>=2.20.0,<3",
    "ruff>=0.0.292,<0.0.293",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.uv]
package = false

[tool.black]
line-length = 101
target-version = ["py38"]

[tool.isort]
profile = "black"
line_length = 101
skip_gitignore = true

[tool.ruff]
ignore = ["E731"]
line-length = 101
select = [
  "B",
  "E",
  "F",
  "TID",
  "W",
]

[tool.pytest.ini_options]
filterwarnings = "ignore::DeprecationWarning"
markers = [
  "slow: Marks slow tests",
  "dataset: Marks tests with dataset dependencies"
]
addopts = " -m 'not slow'"  # Do not run those tests by default
